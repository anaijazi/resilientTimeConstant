filter(DateTime >= test_start_date & DateTime <= test_end_date)
test_set_clean <- test_set %>%
select(-DateTime)
# Function to train the model, returning the entire
# Load necessary libraries
library(caret)
library(tidyverse)
library(lubridate)
library(ggplot2)
library(RColorBrewer)
library(janitor)
# --- GLOBAL SETUP ---
# Set the desired calendar order for all plots
SEASON_ORDER <- c(
"Winter",
"Winter_Spring_Hybrid",
"Spring",
"Spring_Summer_Hybrid",
"Summer"
)
# Shared modeling parameters
n_iterations <- 30 # UPDATED: Increased iterations to 30 for stability
CI_factor <- 1.96
target_weeks <- 6
# rows_per_week: Assuming 5-minute intervals (7 days * 24 hours * 60 minutes / 5 minutes)
rows_per_week <- 7 * 24 * 60 / 5
target_rows <- target_weeks * rows_per_week
fit_control <- trainControl(method = "none")
# Fixed Test Period
test_start_date <- ymd("2017-08-25")
test_end_date <- ymd("2017-09-07")
# Define Seasonal Blocks
seasonal_blocks <- list(
Winter = list(start = ymd("2017-01-01"), end = ymd("2017-03-19")),
Spring = list(start = ymd("2017-03-20"), end = ymd("2017-06-20")),
Summer = list(start = ymd("2017-06-21"), end = ymd("2017-08-24")),
Winter_Spring_Hybrid = list(start = ymd("2017-02-04"), end = ymd("2017-05-04")),
Spring_Summer_Hybrid = list(start = ymd("2017-05-07"), end = ymd("2017-08-04"))
)
# --- DATA LOADING AND MODELING FUNCTIONS ---
# Read data, ensure explicit column names, and arrange by time
final_preprocessed_data <- readr::read_csv("../data/final_preprocessed_data.csv", show_col_types = FALSE) %>%
janitor::clean_names() %>%
rename(DateTime = date_time) %>%
rename(Thermostat_Temperature = thermostat_temperature) %>%
arrange(DateTime)
# Prepare the fixed test set
test_set <- final_preprocessed_data %>%
filter(DateTime >= test_start_date & DateTime <= test_end_date)
test_set_clean <- test_set %>%
select(-DateTime)
# Function to train the model, returning the entire model object
train_model_only <- function(train_data) {
train_data_clean <- train_data %>% select(-DateTime)
train_formula <- as.formula(paste("Thermostat_Temperature ~ ."))
model <- suppressWarnings(
caret::train(
form = train_formula, data = train_data_clean, trControl = fit_control,
method = "lm", preProcess = c("center", "scale")
)
)
return(model)
}
# ----------------------------------------------------------------------
# 1. Data Generation and Ordering Block
# ----------------------------------------------------------------------
# --- PART 1: RMSE LEARNING CURVE CALCULATION (1-12 Weeks) ---
cat("\nStarting RMSE Learning Curve Calculation (1-12 Weeks)...\n")
results_df_lc <- data.frame()
min_train_size <- 7 * 24 * 6
# Define new steps based on weeks 1 through 12
target_weeks_steps <- 1:12
target_row_steps <- floor(target_weeks_steps * rows_per_week)
for (period_name in names(seasonal_blocks)) {
base_train_set <- final_preprocessed_data %>%
filter(DateTime >= seasonal_blocks[[period_name]]$start & DateTime <= seasonal_blocks[[period_name]]$end)
full_train_size <- nrow(base_train_set)
if (full_train_size < min_train_size) next
current_period_sizes <- target_row_steps[target_row_steps < full_train_size]
if (full_train_size > max(current_period_sizes, default = 0)) {
current_period_sizes <- unique(c(current_period_sizes, full_train_size))
}
current_period_sizes <- current_period_sizes[current_period_sizes >= min_train_size]
for (current_train_size_rows in current_period_sizes) {
for (i in 1:n_iterations) {
temp_train_set <- base_train_set %>% sample_n(current_train_size_rows, replace = FALSE)
rmse <- tryCatch({
model <- train_model_only(temp_train_set)
predictions <- predict(model, newdata = test_set_clean)
sqrt(mean((predictions - test_set_clean$Thermostat_Temperature)^2, na.rm = TRUE))
}, error = function(e) NA)
results_df_lc <- bind_rows(results_df_lc, data.frame(
period = period_name, iteration = i, model = "lm",
rmse = rmse, train_size = current_train_size_rows
))
}
}
}
# Summarize and ORDER RMSE Data
results_summary_lc <- results_df_lc %>%
group_by(period, train_size) %>%
summarise(
mean_rmse = mean(rmse, na.rm = TRUE),
sd_rmse = sd(rmse, na.rm = TRUE),
.groups = 'drop'
) %>%
mutate(period = factor(period, levels = SEASON_ORDER))
# --- PART 2: 6-WEEK PREDICTION CALCULATION (Coefficient Extraction Included) ---
cat("\nStarting 6-Week Prediction Calculation and Coefficient Extraction...\n")
final_plot_data_list <- list()
all_coefs_list <- list() # LIST TO STORE COEFFICIENTS
for (period_name in names(seasonal_blocks)) {
base_train_set <- final_preprocessed_data %>%
filter(DateTime >= seasonal_blocks[[period_name]]$start & DateTime <= seasonal_blocks[[period_name]]$end)
full_train_size <- nrow(base_train_set)
if (target_rows > full_train_size) next
prediction_matrix <- matrix(NA, nrow = nrow(test_set_clean), ncol = n_iterations)
coef_matrix <- NULL
for (j in 1:n_iterations) {
max_start_row <- full_train_size - target_rows + 1
random_start_row <- sample(1:max_start_row, 1)
end_row <- random_start_row + target_rows - 1
temp_train_set <- base_train_set %>% slice(random_start_row:end_row)
model <- train_model_only(temp_train_set)
predictions <- predict(model, newdata = test_set_clean)
prediction_matrix[, j] <- predictions
# EXTRACT COEFFICIENTS
current_coefs <- coef(model$finalModel)
if (is.null(coef_matrix)) {
coef_names <- names(current_coefs)[-1]
coef_matrix <- matrix(NA, nrow = n_iterations, ncol = length(coef_names))
colnames(coef_matrix) <- coef_names
}
# Store coefficients (excluding intercept)
coef_matrix[j, ] <- current_coefs[-1]
}
# Store all 30 sets of coefficients for this period
all_coefs_list[[period_name]] <- as.data.frame(coef_matrix) %>%
mutate(Iteration = 1:n_iterations, Period = period_name)
# Summarize predictions
summarized_predictions <- test_set %>%
select(DateTime, Actual_Temp = Thermostat_Temperature) %>%
mutate(
Mean_Predicted_Temp = rowMeans(prediction_matrix, na.rm = TRUE),
SD_Predicted_Temp = apply(prediction_matrix, 1, sd, na.rm = TRUE),
Lower_CI = Mean_Predicted_Temp - CI_factor * SD_Predicted_Temp,
Upper_CI = Mean_Predicted_Temp + CI_factor * SD_Predicted_Temp
)
rmse_value <- sqrt(mean((summarized_predictions$Mean_Predicted_Temp - summarized_predictions$Actual_Temp)^2, na.rm = TRUE))
summarized_predictions$Period <- period_name
summarized_predictions$RMSE_Label <- paste0(period_name, "\nRMSE (Mean): ", round(rmse_value, 3))
final_plot_data_list[[period_name]] <- summarized_predictions
}
# Combine and ORDER Prediction Data
all_predictions_df <- bind_rows(final_plot_data_list) %>%
mutate(Period = factor(Period, levels = SEASON_ORDER)) %>%
mutate(RMSE_Label = factor(RMSE_Label, levels = unique(.$RMSE_Label[order(.$Period)])))
# Define Color Map (Set1)
set1_colors <- brewer.pal(n = 5, name = "Set1")
names(set1_colors) <- SEASON_ORDER
season_colors_map_vector <- set1_colors
cat("\nData generation complete. You can now run the plotting blocks (2, 3, and 4).\n")
# ----------------------------------------------------------------------
# 2. RMSE Learning Curve Plot Block (Axes and Symbol Fixes)
# ----------------------------------------------------------------------
if (!exists("results_summary_lc")) {
stop("Please run the 'Data Generation and Ordering Block' first.")
}
if (!exists("rows_per_week")) {
stop("The variable 'rows_per_week' must be defined in Block 1.")
}
cat("\nGenerating RMSE Learning Curve Plot...\n")
results_summary_lc_weeks <- results_summary_lc %>%
mutate(train_weeks = train_size / rows_per_week)
rmse_plot <- results_summary_lc_weeks %>%
ggplot(aes(x = train_weeks, y = mean_rmse, group = period, color = period)) +
# Y-Axis Limits set from 0 to 0.5
ylim(0, 0.5) +
geom_line(linewidth = 1) +
geom_point(size = 3) +
geom_ribbon(aes(ymin = mean_rmse - sd_rmse, ymax = mean_rmse + sd_rmse, fill = period),
alpha = 0.15, linetype = 0) +
geom_text(data = results_summary_lc_weeks %>% filter(train_weeks == max(train_weeks)),
aes(label = round(mean_rmse, 3), color = period),
vjust = -1.5, size = 3.5) +
labs(
title = "Linear Model Learning Curve by Pure and Hybrid Seasonal Data (Calendar Order)",
# Plotmath expression used for the correct ± symbol
subtitle = expression(paste("Performance on Fixed Extreme Heat Test Set (Ribbon shows ", symbol("\261"), " 1 SD, based on 30 iterations)")),
x = "Training Data Size (Number of Weeks)",
y = "Root Mean Squared Error (RMSE)",
color = "Training Season",
fill = "Training Season"
) +
theme_minimal() +
scale_color_manual(values = season_colors_map_vector) +
scale_fill_manual(values = season_colors_map_vector) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5)
)
print(rmse_plot)
# ----------------------------------------------------------------------
# 3. Time-Series and Scatter Plots Block (Legend and Position Fixes)
# ----------------------------------------------------------------------
if (!exists("all_predictions_df")) {
stop("Please run the 'Data Generation and Ordering Block' first.")
}
# --- A. Time-Series Facet Plot (Legend Clean-up) ---
cat("\nGenerating Time-Series Facet Plot (Ordered by Calendar Year)...\n")
p_facet_ts <- ggplot(all_predictions_df, aes(x = DateTime)) +
# CI ribbon is on the plot, but removed from the legend (show.legend = FALSE)
geom_ribbon(aes(ymin = Lower_CI, ymax = Upper_CI, fill = Period), alpha = 0.25, show.legend = FALSE) +
geom_line(aes(y = Actual_Temp, color = "Actual Temp"), linewidth = 1.0) +
geom_line(aes(y = Mean_Predicted_Temp, color = Period), linewidth = 0.8, linetype = "solid") +
facet_wrap(~ RMSE_Label, scales = "free_y") +
scale_color_manual(
name = "Temperature Source",
values = c("Actual Temp" = "darkgrey", season_colors_map_vector)
) +
labs(
title = "Time-Series Comparison: Actual vs. Mean Predicted Temp (Calendar Order)",
subtitle = "Ribbon and Predicted Line color match the season's Set1 RMSE color.",
x = "Date and Time",
y = "Thermostat Temperature (°F)"
) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "right") # Legend moved to the right
print(p_facet_ts)
# --- B. Scatter Plot (Actual vs. Predicted, Calendar Order) ---
cat("\nGenerating Scatter Plot (Ordered by Calendar Year)...\n")
p_scatter <- ggplot(all_predictions_df, aes(x = Actual_Temp, y = Mean_Predicted_Temp)) +
geom_point(aes(color = Period), alpha = 0.6, size = 2) +
geom_smooth(aes(color = Period), method = "lm", se = FALSE, linewidth = 1) +
geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "darkgrey", linewidth = 1.2) +
facet_wrap(~ RMSE_Label, scales = "fixed", ncol = 3) +
scale_color_manual(
name = "Training Season",
values = season_colors_map_vector
) +
labs(
title = "Model Performance Bias: Actual vs. Mean Predicted Temperature (Calendar Order)",
subtitle = "Fixed Extreme Heat Test Set | Dashed line indicates perfect prediction (Y=X)",
x = "Actual Thermostat Temperature (°F)",
y = "Mean Predicted Thermostat Temperature (°F)"
) +
coord_equal() +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
print(p_scatter)
# ----------------------------------------------------------------------
# 4. Variable Importance (Coefficient) Analysis and Plot Block (NEW)
# ----------------------------------------------------------------------
if (!exists("all_coefs_list")) {
stop("Please run the 'Data Generation and Ordering Block' first.")
}
cat("\nGenerating Coefficient Plot...\n")
# Combine all coefficient data frames
all_coefs_df <- bind_rows(all_coefs_list)
# Reshape from wide to long format for ggplot
coefs_long <- all_coefs_df %>%
pivot_longer(
cols = -c(Iteration, Period),
names_to = "Variable",
values_to = "Coefficient"
) %>%
mutate(Period = factor(Period, levels = SEASON_ORDER))
# Summarize coefficients: Mean and CI across all 30 iterations
CI_factor_95 <- 1.96 # Redefine factor for clarity
coefs_summary <- coefs_long %>%
group_by(Period, Variable) %>%
summarise(
Mean_Coef = mean(Coefficient, na.rm = TRUE),
SD_Coef = sd(Coefficient, na.rm = TRUE),
SE_Coef = SD_Coef / sqrt(n()),
Lower_CI = Mean_Coef - CI_factor_95 * SE_Coef,
Upper_CI = Mean_Coef + CI_factor_95 * SE_Coef,
.groups = 'drop'
) %>%
# Filter out variables that are essentially zero across all periods to clean up the plot
group_by(Variable) %>%
mutate(Max_Abs_Coef = max(abs(Mean_Coef))) %>%
ungroup() %>%
filter(Max_Abs_Coef > 0.005)
# Plotting the coefficients
p_coefs <- coefs_summary %>%
# Order variables by the maximum absolute coefficient across all periods
mutate(Variable = fct_reorder(Variable, Max_Abs_Coef, .fun = max)) %>%
ggplot(aes(x = Mean_Coef, y = Variable, color = Period)) +
geom_point(position = position_dodge(width = 0.5), size = 3) +
# Draw error bars using the 95% Confidence Interval
geom_errorbar(aes(xmin = Lower_CI, xmax = Upper_CI),
position = position_dodge(width = 0.5), linewidth = 0.8, width = 0.2) +
geom_vline(xintercept = 0, linetype = "dashed", color = "darkgrey") +
labs(
title = "Standardized Regression Coefficients (Variable Importance) by Training Season",
subtitle = "Horizontal bars represent 95% Confidence Intervals (CI) across 30 models.",
x = "Standardized Coefficient Value",
y = "Model Predictor Variable",
color = "Training Season"
) +
scale_color_manual(values = season_colors_map_vector) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
print(p_coefs)
View(p_coefs)
